{
  "name": "laravel-github-deploy-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Vue interface of the Laravel Github deploy DirectAdmin plugin. Builds into ../plugin/images.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.46",
    "vue-router": "4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "vue-tsc": "3.3.14"
  }
}
